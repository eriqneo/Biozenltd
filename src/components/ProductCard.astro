---
import ProductImage from './ProductImage.astro';
import { formatKES, stockLabel, stockTone } from '../lib/format';
import type { Product } from '../lib/types';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const onSale = !p.quote_only && p.compare_at_price && p.compare_at_price > p.price;
---

<article class="card group flex flex-col overflow-hidden transition hover:shadow-md hover:ring-brand-600/30">
  <a href={`/product/${p.slug}`} class="flex flex-1 flex-col">
    <div class="relative">
      <ProductImage src={p.images[0]} alt={p.name} class="aspect-[4/3] w-full" />
      {onSale && <span class="absolute left-3 top-3 rounded-full bg-red-600 px-2 py-0.5 text-xs font-semibold text-white">Offer</span>}
    </div>
    <div class="flex flex-1 flex-col gap-2 p-4">
      <h3 class="font-medium leading-snug group-hover:text-brand-700 line-clamp-2">{p.name}</h3>
      <p class="text-sm text-ink-600 line-clamp-2">{p.summary}</p>
      <div class="mt-auto flex flex-wrap items-end justify-between gap-2 pt-2">
        {p.quote_only ? (
          <span class="font-semibold text-brand-800">Price on quote</span>
        ) : (
          <span class="flex items-baseline gap-2">
            <span class="font-semibold tabular-nums">{formatKES(p.price)}</span>
            {onSale && <s class="text-xs text-ink-500 tabular-nums">{formatKES(p.compare_at_price!)}</s>}
          </span>
        )}
        <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset', stockTone[p.stock]]}>{stockLabel[p.stock]}</span>
      </div>
    </div>
  </a>
</article>
