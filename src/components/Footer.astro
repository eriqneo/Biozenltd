---
import { footerNav, site, whatsappLink } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-ink-900 text-ink-200">
  <div class="container-x grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-6">
    <div class="lg:col-span-2 space-y-3">
      <a href="/" class="inline-block rounded-xl bg-white px-4 py-3" aria-label={`${site.name} home`}>
        <img src="/images/brand/biozen-logo.png" alt={site.name} width="362" height="90" loading="lazy" class="h-10 w-auto" />
      </a>
      <p class="text-sm text-ink-200/80">{site.tagline}.</p>
      <ul class="text-sm space-y-1">
        <li><a href={`tel:${site.phoneIntl}`} class="hover:text-white">{site.phone}</a></li>
        <li><a href={whatsappLink('Hello Biozen')} target="_blank" rel="noopener" class="hover:text-white">WhatsApp us</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li>{site.location}</li>
      </ul>
    </div>
    {Object.entries(footerNav).map(([heading, links]) => (
      <nav aria-label={heading}>
        <p class="text-sm font-semibold text-white mb-3">{heading}</p>
        <ul class="space-y-2 text-sm">
          {links.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-ink-200/70">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Pay with M-PESA · Visa · Mastercard · Bank transfer</p>
    </div>
  </div>
</footer>
