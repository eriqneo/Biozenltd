---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShopBrowser from '../../components/islands/ShopBrowser';
import { getBrands, getTopCategories } from '../../lib/catalog';
import { getShopIndex } from '../../lib/shop-index';

const [index, categories, brands] = await Promise.all([getShopIndex(), getTopCategories(), getBrands()]);

// Only the first page goes into the HTML; the full index loads from
// /shop-index.json so the page stays light with a large catalogue.
const initial = [...index]
  .sort((a, b) => Number(b.featured) - Number(a.featured) || b.created.localeCompare(a.created))
  .slice(0, 24);
---

<Base title="Shop medical equipment" description="Browse medical equipment, hospital furniture, laboratory, theatre and rehab equipment. Request a quotation with delivery and installation across Kenya.">
  <div class="container-x py-8 space-y-6">
    <Breadcrumbs items={[{ label: 'Shop' }]} />
    <h1 class="text-3xl font-bold tracking-tight">All equipment</h1>
    <ShopBrowser
      client:load
      initial={initial}
      total={index.length}
      indexUrl="/shop-index.json"
      categories={categories.map((c) => ({ id: c.id, name: c.name }))}
      brands={brands.map((b) => ({ id: b.id, name: b.name }))}
    />
  </div>
</Base>
