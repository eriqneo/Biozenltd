---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" index={false}>
  <div class="container-x py-20 text-center space-y-4">
    <p class="eyebrow">404</p>
    <h1 class="text-3xl font-bold tracking-tight">We couldn't find that page.</h1>
    <p class="text-ink-600">It may have moved, or the link may be wrong.</p>
    <div class="flex flex-wrap justify-center gap-3 pt-2">
      <a href="/shop" class="btn-primary">Browse equipment</a>
      <a href="/contact" class="btn-secondary">Contact us</a>
    </div>
  </div>
</Base>
