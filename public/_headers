# Cloudflare static asset headers (applies to prerendered pages and files).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Astro's hashed build files never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Product images: cache a day, serve stale while refreshing.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Never cache personal pages.
/cart
  Cache-Control: no-store
/checkout
  Cache-Control: no-store
/account/*
  Cache-Control: no-store
